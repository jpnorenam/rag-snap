test-rfp/

# UI project files: the broad *.json rule above would otherwise swallow the
# UI's package manifests. npm ci (used by `make ui` and the snapcraft build)
# requires a committed lockfile, so these must be tracked.
!ui/package.json
!ui/package-lock.json
!ui/tsconfig.json
# Build artifacts and deps are not tracked (the UI build regenerates them).
ui/node_modules/
ui/.next/
ui/out/
ui/next-env.d.ts
ui/tsconfig.tsbuildinfo

# UX planning docs are working notes, not shipped documentation — keep them
# local (mirrors the PLAN.md convention).
docs/ux/

# The embedded UI dist holds only a committed placeholder index.html; the real
# SPA is copied in by `make ui` / the snapcraft build and must not be committed.
# (A nested .gitignore can't work here: the root rule above ignores every file
# named .gitignore.)
internal/webui/dist/*
!internal/webui/dist/index.html

# Local working kit — not part of the project.
hackathon-ux-harness-kit*/

# RFP working files. An in-flight RFP leaves its source document, the manifest
# the extractor generates beside it, the answers, and prompt drafts in the repo
# root. That is per-engagement working data, not project data, and the source
# documents are large. These rules are root-anchored (leading /), so documents
# and fixtures under docs/ and testdata/ are unaffected.
#
# The *.yaml rule is broad on purpose — a new RFP should be ignored without
# anyone remembering to add a rule. The cost is that a genuinely new root-level
# YAML file must be un-ignored here, the way rest-api.yaml is.
/*.pdf
/*.xlsx
/*.docx
/*.txt
/*.yaml
!/rest-api.yaml
