#!/bin/bash -eu

tag="snap.$SNAP_INSTANCE_NAME.hook.post-refresh"

# Redirect stdout to stdout+syslog
exec 1> >(tee >(logger --tag=$tag))
# Redirect stderr to stderr+syslog
exec 2> >(logger --stderr --priority error --tag=$tag)

# Register package-layer config keys added since this installation's revision, so
# a refreshed installation can configure them (a user-layer set rejects keys the
# package layer lacks). Values that are already set are left alone.
. "$SNAP/bin/package-config.sh"

# kapa.api.key is no longer a config key: the API key comes from KAPA_API_KEY in
# the environment only. Remove any stored value from both layers so a credential
# does not linger in snapd state. Unsetting a key that is not there is not an
# error worth failing the refresh over.
snapctl unset config.package.kapa.api.key || true
snapctl unset config.user.kapa.api.key || true

# Answer judge. Keep in sync with the install hook, which documents each key.
seed judge.enabled "true"
seed judge.model ""
seed judge.reasoning "medium"
seed judge.concurrency "4"

# Retired keys. analysis.http.* addressed a configurable (gateway) endpoint; analysis
# now calls the Gemini API only, so the keys are gone. An install that seeded them
# would otherwise keep showing them in `rag get`, and a stale user-layer value would
# survive with nothing reading it. Both layers are cleared; unsetting an absent key
# is harmless, so this is safe to run on every refresh.
snapctl unset config.package.analysis.http || true
snapctl unset config.user.analysis.http || true

# A refresh preserves whatever startup state the services already had, so an operator who
# enabled them once needs nothing here. Only a service that has never been enabled stays
# disabled, and it needs --enable to survive the next reboot:
#
# snap start --enable $SNAP_INSTANCE_NAME.tika-server