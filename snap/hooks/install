#!/bin/bash -eu

tag="snap.$SNAP_INSTANCE_NAME.hook.install"

# Redirect stdout to stdout+syslog
exec 1> >(tee >(logger --tag=$tag))
# Redirect stderr to stderr+syslog
exec 2> >(logger --stderr --priority error --tag=$tag)

# Backend secrets (OPENSEARCH_USERNAME/PASSWORD, CHAT_API_KEY, KAPA_API_KEY, GEMINI_API_KEY)
# are never set here: this hook is one-shot and does not persist into the ragd daemon's
# runtime environment. See the `ragd` app's environment comment in snapcraft.yaml for how
# operators inject them.

# Register the package-layer config keys and their defaults (shared with post-refresh):
# the bundled Tika, a local OpenSearch, and empty chat/model keys. See package-config.sh.
. "$SNAP/bin/package-config.sh"

# Services: snapd enables and starts tika-server on install (it needs no secrets).
# ragd is install-mode: disable on purpose: once running it serves every CLI command,
# and right after install it has no secrets, so commands would fail with 401. Enable it
# once its secrets are in place, with --enable so it survives reboots:
#
#   sudo snap start --enable $SNAP_INSTANCE_NAME.ragd
