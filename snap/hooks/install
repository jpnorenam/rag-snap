#!/bin/bash -eu

tag="snap.$SNAP_INSTANCE_NAME.hook.install"

# Redirect stdout to stdout+syslog
exec 1> >(tee >(logger --tag=$tag))
# Redirect stderr to stderr+syslog
exec 2> >(logger --stderr --priority error --tag=$tag)

#
# Set generic configurations
#

# sudo $SNAP_INSTANCE_NAME set --package chat.http.host="127.0.0.1"
# sudo $SNAP_INSTANCE_NAME set --package chat.http.port="8324"
# sudo $SNAP_INSTANCE_NAME set --package chat.http.path="v1"
# sudo $SNAP_INSTANCE_NAME set --package knowledge.http.host="127.0.0.1"
# sudo $SNAP_INSTANCE_NAME set --package knowledge.http.port="9200"
# sudo $SNAP_INSTANCE_NAME set --package knowledge.http.tls="true"
# sudo $SNAP_INSTANCE_NAME set --package tika.http.path="tika"
# sudo $SNAP_INSTANCE_NAME set --package tika.http.port="9998"
# sudo $SNAP_INSTANCE_NAME set --package tika.http.host="127.0.0.1"
# sudo $SNAP_INSTANCE_NAME set --package verbose="false"
#
# Backend secrets (OPENSEARCH_USERNAME/PASSWORD, CHAT_API_KEY) are never set here: this hook
# is one-shot and does not persist into the ragd daemon's runtime environment. See the
# `ragd` app's environment comment in snapcraft.yaml for how operators inject them.

# Register the chat backend's wire protocol so users can switch it with:
#   sudo rag set chat.api=anthropic
# openai    — OpenAI Chat Completions: a local Inference snap, or a third party's
#             OpenAI-compatible route (e.g. Bedrock bedrock-runtime …/openai/v1). Default.
# anthropic — Anthropic Messages API, e.g. Claude on Bedrock: chat.http.host=
#             bedrock-runtime.<region>.amazonaws.com, chat.http.path=anthropic,
#             chat.model=global.anthropic.claude-sonnet-5-5. chat.model is required (no model
#             listing) and sampling temperature is not sent. CHAT_API_KEY is the bearer.
snapctl set config.package.chat.api="openai"

# Register Google Drive OAuth2 credential keys so users can configure them with:
#   sudo rag set gdrive.client.id=<client-id>
#   sudo rag set gdrive.client.secret=<client-secret>
snapctl set config.package.gdrive.client.id=""
snapctl set config.package.gdrive.client.secret=""

# Register Kapa AI keys so users can configure them with:
#   sudo rag set kapa.enabled=false
#   sudo rag set kapa.api.key=<key>
#   sudo rag set kapa.project.id=<id>
snapctl set config.package.kapa.enabled="true"
snapctl set config.package.kapa.api.key=""
snapctl set config.package.kapa.project.id=""

# Register RFP analysis keys. Analysis sends RFP documents directly to Google's
# Gemini API and generates a complete answer-batch manifest, so it is OFF by
# default: it sends document content to a third party. There is no gateway and no
# configurable endpoint — the destination is fixed in code. Enable it with:
#   sudo rag set analysis.enabled=true
#   sudo rag set analysis.model=<gemini-model-id>
#
# analysis.model has no default on purpose. Gemini model ids are versioned (the Pro
# tier currently ships only under a preview identifier), so baking one in would age
# badly and fail as an opaque 404. Ids are unprefixed — not google/... as on a
# gateway. Verified values:
#   gemini-3.1-pro-preview   Pro tier, preview (deprecated with >= 2 weeks' notice)
#   gemini-3.8-flash         newest stable model
#
# The API key is NEVER config: it comes from GEMINI_API_KEY only, with no fallback
# to CHAT_API_KEY (that key belongs to the chat backend, never to Google). The key
# MUST belong to a billing-enabled (paid-tier) Google project: on the unpaid tier,
# Google may use submitted content to improve its products and human reviewers may
# read it. See the `ragd` app's environment comment in snapcraft.yaml.
#
# Keep this list in sync with the seeding block in the post-refresh hook, which
# registers the same keys on an already-installed snap.
snapctl set config.package.analysis.enabled="false"
snapctl set config.package.analysis.model=""
# Question extraction defaults to medium reasoning: at low, a 36-row compliance matrix
# whose cells pack several requirements came back nearly unsplit (53 questions where a
# person wrote 164), and medium cleared it for a few thousand reasoning tokens.
snapctl set config.package.analysis.reasoning.questions="medium"
snapctl set config.package.analysis.reasoning.strategy="high"
snapctl set config.package.analysis.answer.words="100"
snapctl set config.package.analysis.answer.limit="soft"

# Register the REST API daemon (ragd) socket keys. Members of api.socket.group
# (plus root) may access the local unix socket; access is enforced by the daemon's
# SO_PEERCRED check, not by the socket's file ownership (under strict confinement
# the daemon cannot chown the socket to an arbitrary group). api.socket.mode is the
# socket's octal file mode and defaults to 0666 (world-connectable at the DAC
# layer) so non-root group members can reach it; the peercred check is the gate.
# Seeded as package keys so they can be overridden with:
#   sudo rag set api.socket.group=<group>
#   sudo rag set api.socket.mode=<mode>
snapctl set config.package.api.socket.group="rag"
snapctl set config.package.api.socket.mode="0666"

# Register the opt-in loopback (local REST API) listener keys. When enabled, ragd
# also serves the /1.0 API over a 127.0.0.1 TCP listener authenticated by a
# per-installation bearer token (peercred is unavailable for TCP). The listener is
# OFF by default; the bind is loopback-only and a non-loopback address is refused
# by the daemon. Seeded as package keys so they can be overridden with:
#   sudo rag set api.loopback.enabled=true
#   sudo rag set api.loopback.address=127.0.0.1:0   # :0 = OS-assigned port
snapctl set config.package.api.loopback.enabled="false"
snapctl set config.package.api.loopback.address="127.0.0.1:0"
#
# Both daemons below are install-mode: disable, so snapd creates their systemd units but
# leaves them stopped AND disabled at boot. Always start them with --enable: plain
# `snap start` runs them for the current boot only, and they vanish at the next reboot.
# (`snap enable <snap>` is unrelated -- it controls the whole snap, not service startup.)
#
# sudo snap start --enable $SNAP_INSTANCE_NAME.tika-server
# sudo snap start --enable $SNAP_INSTANCE_NAME.ragd